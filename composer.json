{
    "name": "laranail/installer-web",
    "description": "Web UI for laranail/installer-headless \u2014 a Tailwind + Blade + Livewire 4 install wizard that drives the headless installer engine. Holds no install logic; every operation is delegated to the core.",
    "keywords": [
        "laravel",
        "installer",
        "setup",
        "wizard",
        "livewire",
        "tailwind",
        "laranail"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/installer-web",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/installer-web/issues",
        "source": "https://github.com/laranail/installer-web",
        "docs": "https://opensource.simtabi.com/documentation/laranail/installer-web/"
    },
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "laranail/installer-headless": "^0.1",
        "laranail/package-tools": "^0.1",
        "livewire/livewire": "^4.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.5.8",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Installer\\Web\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Installer\\Web\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --colors=always",
        "lint": [
            "@pint",
            "@analyse",
            "@rector"
        ],
        "pint": "vendor/bin/pint --test --config vendor/laranail/package-tools/pint.json",
        "format": "@pint-fix",
        "rector": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "pint-fix": "vendor/bin/pint --parallel --config vendor/laranail/package-tools/pint.json"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Installer\\Web\\Providers\\InstallerWebServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/license-verifier"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/db-tools"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/installer-headless"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ]
}
